{
  "name": "primeprop-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply primeprop-db",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:static && npm run test:worker",
    "test:static": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:integration",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/bcryptjs": "^2.4.6",
    "miniflare": "^5.20260730.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
